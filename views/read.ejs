<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>READ all users</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="bg-zinc-800 h-full w-full min-h-screen">
        <div class="nav text-zinc-300 mt-[15] mb-[15] gap-7 flex">
        <a href="/create" class="text-amber-300 hover:text-amber-400 mt-[15]">Create User  </a>
        <a href="/read" class="text-amber-300 hover:text-amber-400 mt-[15]">Read Users</a>
    </div>
    <h1 class="text-white text-3xl font-bold text-center">READ all users</h1>
    <% if (users.length > 0) { %>
        <div class="users flex flex-wrap gap-10">
        <% users.forEach(user => { %>
        <div class="user flex flex-col gap-5 mt-5 bg-zinc-700 p-5 rounded-lg w-1/6">
            <div class="pic mx-auto bg-zinc-500 w-36 h-26 rounded-lg">
                <img src="<%= user.imageurl %>" alt="user image" class="w-full h-full object-cover rounded-lg">
            </div>
            <div class="name mx-auto text-gray-400"><%= user.name %></div>
            <div class="email mx-auto text-gray-400"><%= user.email %></div>
            <div class="flex gap-5 mx-auto">
                <a href="/edit/<%= user._id %>" class=" text-amber-300 py-2 px-4 ">Edit</a>
                <a href="/delete/<%= user._id %>" class=" text-red-400 py-2 px-4 ">Delete</a>
            </div>
        </div>
        <% }); %>
    </div>
        <%} else { %>
            <p class="text-zinc-300 mt-5">No users found.</p>
        <%}%>
    </div>
    </div>
</body>
</html>